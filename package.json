{
  "name": "deslopify",
  "version": "0.1.0",
  "description": "A quality layer for AI coding agents: codemap, write-time guards, slop detectors and a bounded review loop.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "deslopify": "bin/deslopify"
  },
  "files": [
    "LICENSE",
    "bin",
    "dist/src",
    "fonts",
    "hooks",
    "skills",
    "worlds",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "code-quality",
    "design",
    "hooks",
    "codemap"
  ]
}
